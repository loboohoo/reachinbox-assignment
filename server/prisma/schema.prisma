// Prisma Schema for ReachInbox Hiring Assignment Backend
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------
enum CampaignStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  PAUSED
}

enum EmailStatus {
  DRAFT
  SCHEDULED
  QUEUED
  PROCESSING
  SENT
  FAILED
}

// ----------------------------------------------------
// MODELS
// ----------------------------------------------------

/// User account entity supporting Google OAuth & local auth
model User {
  id               String            @id @default(uuid())
  googleId         String?           @unique
  email            String            @unique
  passwordHash     String?
  name             String
  avatar           String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  
  // Relations
  senders          Sender[]
  campaigns        Campaign[]
  slackConnections SlackConnection[]

  @@map("users")
}

/// Verified email sender profile with Ethereal SMTP defaults
model Sender {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  email       String
  smtpHost    String   @default("smtp.ethereal.email")
  smtpPort    Int      @default(587)
  smtpUser    String
  smtpPass    String
  isVerified  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  emails      Email[]

  @@map("senders")
}

/// Email outreach campaign with scheduling & rate limit parameters
model Campaign {
  id                    String         @id @default(uuid())
  userId                String
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  status                CampaignStatus @default(DRAFT)
  startTime             DateTime?      // Scheduled campaign start time
  minDelayBetweenEmails Int            @default(0) // Minimum delay between emails in seconds
  hourlyLimit           Int            @default(100) // Maximum emails per hour
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  // Relations
  emails                Email[]

  @@map("campaigns")
}

/// Individual email record with idempotency, retry attempts & BullMQ job tracking
model Email {
  id             String      @id @default(uuid())
  campaignId     String?
  campaign       Campaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  senderId       String?
  sender         Sender?     @relation(fields: [senderId], references: [id], onDelete: SetNull)
  recipientEmail String
  subject        String
  snippet        String?
  body           String
  status         EmailStatus @default(DRAFT)
  scheduledAt    DateTime?
  sentAt         DateTime?
  attempts       Int         @default(0) // Delivery attempt count
  idempotencyKey String?     @unique    // Deterministic key to prevent duplicate sends
  messageId      String?                 // Nodemailer / SMTP message identifier
  bullJobId      String?                 // BullMQ job identifier
  tags           String[]    @default([])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status])
  @@index([scheduledAt])
  @@index([recipientEmail])
  @@map("emails")
}

/// Slack OAuth connection for workspace alerts & notification channels
model SlackConnection {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String   // Slack OAuth access token
  teamId      String?  // Slack workspace team ID
  teamName    String?  // Slack workspace name
  channelId   String?  // Slack channel ID
  channelName String?  // Slack channel name
  webhookUrl  String?  // Incoming Webhook URL
  isConnected Boolean  @default(true) // Connection status
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("slack_connections")
}
