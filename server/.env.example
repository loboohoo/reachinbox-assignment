PORT=5000
NODE_ENV=development

POSTGRES_USER="reachinbox"
POSTGRES_PASSWORD="reachinbox_secret"
POSTGRES_DB="reachinbox_db"

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://reachinbox:reachinbox_secret@localhost:5433/reachinbox_db?schema=public"

# Redis Connection Config for BullMQ
REDIS_HOST="localhost"
REDIS_PORT=6379

# Worker Concurrency for BullMQ Queue Processing
WORKER_CONCURRENCY=5

# Elasticsearch Connection Config
ELASTICSEARCH_NODE="http://localhost:9200"

# JWT Secret
JWT_SECRET="reachinbox_super_secret_jwt_key_2026"
JWT_EXPIRES_IN="7d"

# Default Ethereal SMTP Credentials
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_USER="ethereal_user"
SMTP_PASS="ethereal_password"

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_CALLBACK_URL="http://localhost:5000/api/auth/google/callback"
FRONTEND_URL="http://localhost:5173"

# Slack OAuth 2.0 Credentials
SLACK_CLIENT_ID="YOUR_SLACK_CLIENT_ID"
SLACK_CLIENT_SECRET="YOUR_SLACK_CLIENT_SECRET"
SLACK_REDIRECT_URI="http://localhost:5000/api/slack/callback"
